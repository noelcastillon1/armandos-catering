rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Consultation form submissions. The Trigger Email extension sends each
    // new doc; it writes delivery status via the Admin SDK, which bypasses
    // these rules. Public clients may only create a doc addressed to Armando,
    // so the collection can't be read or used as an open mail relay.
    match /mail/{mailId} {
      allow create: if request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to == ['chefarmandocatering@gmail.com']
        && request.resource.data.message.keys().hasOnly(['subject', 'html'])
        && request.resource.data.message.subject is string
        && request.resource.data.message.subject.size() <= 200
        && request.resource.data.message.html is string
        && request.resource.data.message.html.size() <= 20000;
    }

    // Everything else is denied by default.
  }
}
